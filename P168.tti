OL,0,        ECIMSBWebfax 2   F168A1790335447
OL,1,W5j 5Q7+j 55"k#j 5w;js1
OL,2,W//%*// //%Q-.*,%-,* *,%%**,$ ,,,,,,,,,,
OL,3,A'Cheeky' fees prompts choirs to pull
OL,4,Aout of festival headlined by Andrea
OL,5,ABocelli
OL,6,
OL,7,FHuw Watkins, who has performed in the
OL,8,FRoyal Albert Hall and at Wales rugby
OL,9,Fmatches with Glynneath Male Voice
OL,10,FChoir, said: "We couldn't get over it -
OL,11,Fwe've never paid anything before to
OL,12,Fparticipate."
OL,14,FThe event organisers, The Land of Song
OL,15,FFestival and the Principality Stadium,
OL,16,Fhave been asked to comment.
OL,23,APub: 24-SepQppppppppppppppppppppppG2/2
