OL,0,        ECIMSBWebfax 2   F119A1794543849
OL,1,W5j 5Q7+j 55"k#j 5w;js1
OL,2,W//%*// //%Q-.*,%-,* *,%%**,$ ,,,,,,,,,,
OL,3,ADuran Duran drummer quits band due to
OL,4,Atinnitus
OL,5,
OL,6,FThe group, made up of Simon Le Bon,
OL,7,Fkeyboardist Nick Rhodes and guitarist
OL,8,FJohn Taylor, said his decision came
OL,9,Fafter "careful consideration and
OL,10,Fmedical advice", which said that
OL,11,F"protecting his hearing and long-term
OL,12,Fhealth must now come first".
OL,23,APub: 12-NovQpppppppppppppppppppppG14/18
