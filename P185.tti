OL,1,Q] Spp`p0pp`pp`p0ppQ|^T\|||||||||||G3/6
OL,2,Q] Sfj= .j5j=1j5   D]  A]CEducation
OL,3,Q] S#""#!# "##"!!"!   D]  A] CReviews
OL,4, T|||||||||||||||||||~|||||||||||
OL,5,A]CMThe Master Compact computer D]
OL,7, T||||||||||||||||||||||||||||||]
OL,8, T]FThree packages are available:
OL,9, T]F
OL,10, T]C*FCompact Colour, including
OL,11, T]F  computer, 3\" disc drive, and
OL,12, D]  Fcolour monitor.
OL,13, T]F  Price:C#687.35 inc. VAT
OL,14, D]F
OL,15, D]C*FCompact Mono, including computer,
OL,16, D]F  3\" disc drive, and green-screen
OL,17, D]F  monitor.
OL,18, D]F  Price:C#537.85 inc. VAT
OL,19, D]
OL,20, D]C*FCompact Basic, including computer
OL,21, D]F  and 3\" disc drive.
OL,22, D]F  Price:C#441.25 inc. VAT
OL,23, D]F                  A]CFrom 06-09-86
OL,24,ANext PageBT'text FilesCRewindFReg Radio
