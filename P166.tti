OL,0,        ECIMSBWebfax 2   F166A1790285052
OL,1,W5j 5Q7+j 55"k#j 5w;js1
OL,2,W//%*// //%Q-.*,%-,* *,%%**,$ ,,,,,,,,,,
OL,3,A'Cheeky' fees prompts choirs to pull
OL,4,Aout of Andrea Bocelli gig
OL,5,
OL,6,FHuw Watkins, who has performed in the
OL,7,FRoyal Albert Hall and at Wales rugby
OL,8,Fmatches with Glynneath Male Voice
OL,9,FChoir, said: "We couldn't get over it -
OL,10,Fwe've never paid anything before to
OL,11,Fparticipate."
OL,13,FThe event organisers, The Land of Song
OL,14,FFestival and the Principality Stadium,
OL,15,Fhave been asked to comment.
OL,23,APub: 24-SepQppppppppppppppppppppppG2/2
