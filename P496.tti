OL,6, ]RT                        !
OL,7, ] D                                  R
OL,8, ] A DBlank teletext screens in 1993
OL,9, ] D   courtesy of Her Majesty's
OL,10, ] D   Government.
OL,11, ] D                                  R
OL,12, ] AEDThat's what you can expect     R
OL,13, ] D   on ITV and C4 if you don't
OL,14, ] D   act NOW.         R
OL,15, ] D                                  R
OL,16, ] A DYou are reading ORACLE now. Do
OL,17, ] D   you like ORACLE? Do you want to
OL,18, ]    Dbe left with just Ceefax?
OL,19, ] D
OL,20,D]G    WRITE TO YOUR OWN MP AT THE
OL,21,D]G HOUSE OF COMMONS, LONDON SW1 - OR
OL,22,D]GDAVID MELLOR, BROADCASTING MINISTER
OL,23,D]G   HOUSE OF COMMONS, LONDON SW1
OL,24,ANext PageBT'text FilesCRewindFReg Radio
FL,497,190,120,250,0,100
PN,49620
SC,0020
CT,25,T
PS,c008
OL,0,        ECIMSBWebfax 2   F496A1772570817
OL,1, ]DFrom 03-03-90                  G20/24
OL,2, ]       Tx,$`<t`<th<th<th4|h<
OL,3, ]       Tor?*u?*u?ju?jw=`s?jw
OL,4, ]       T  xl0|l0xl0xl0| |$,4
OL,5, ]       T  oz%k4k5ox$01'!
OL,6, ]RT                        !
OL,7, ] D                                  R
OL,8, ] AD The Government's Broadcasting
OL,9, ] D   Bill does not recognise public
OL,10, ] D   access teletext as a medium.
OL,11, ] D
OL,12, ] AD David Mellor does not believe it
OL,13, ] D   necessary to include a teletext
OL,14, ] D   franchise in the TV auction.   R
OL,15, ] D
OL,16, ] AD The Bill is currently being
OL,17, ] D   debated but the Government sees
OL,18, ] D   no reason to change it.
OL,19, ]                                    R
OL,20,D]G    WRITE TO YOUR OWN MP AT THE
OL,21,D]G HOUSE OF COMMONS, LONDON SW1 - OR
OL,22,D]GDAVID MELLOR, BROADCASTING MINISTER
OL,23,D]G   HOUSE OF COMMONS, LONDON SW1
OL,24,ANext PageBT'text FilesCRewindFReg Radio
FL,497,190,120,250,0,100
PN,49621
SC,0021
CT,25,T
PS,c008
OL,0,        ECIMSBWebfax 2   F496A1772570817
OL,1, ]DFrom 03-03-90                  G21/24
OL,2, ]       Tx,$`<t`<th<th<th4|h<
OL,3, ]       Tor?*u?*u?ju?jw=`s?jw
OL,4, ]       T  xl0|l0xl0xl0| |$,4
OL,5, ]       T  oz%k4k5ox$01'!
OL,6, ]RT                        !
OL,7, ]D                                   R
OL,8, ]DADORACLE wants the chance to bid
OL,9, ]D   for a teletext franchise. We
OL,10, ]D   are happy to compete for this.
OL,11, ]D
OL,12, ]DADThe Government's Broadcasting
OL,13, ]D   Bill won't give us that chance.
OL,14, ]D   There won't be a teletext auction.
OL,15, ]D
OL,16, ]DADWe can't bid against big business
OL,17, ]D   interests and the transmission of
OL,18, ]D   private, coded business services.
OL,19, ]                                    R
OL,20,D]G    WRITE TO YOUR OWN MP AT THE
OL,21,D]G HOUSE OF COMMONS, LONDON SW1 - OR
OL,22,D]GDAVID MELLOR, BROADCASTING MINISTER
OL,23,D]G   HOUSE OF COMMONS, LONDON SW1
OL,24,ANext PageBT'text FilesCRewindFReg Radio
FL,497,190,120,250,0,100
PN,49622
SC,0022
CT,25,T
PS,c008
OL,0,        ECIMSBWebfax 2   F496A1772570817
OL,1, ]DFrom 03-03-90                  G22/24
OL,2, ]       Tx,$`<t`<th<th<th4|h<
OL,3, ]       Tor?*u?*u?ju?jw=`s?jw
OL,4, ]       T  xl0|l0xl0xl0| |$,4
OL,5, ]       T  oz%k4k5ox$01'!
OL,6, ]RT                        !
OL,7, ]D
OL,8, ]DADDavid Mellor does not feel
OL,9, ]D   strongly about ORACLE. He says
OL,10, ]D   he will "reflect" on our case.
OL,11, ]D
OL,12, ]DADNearly seven million people have
OL,13, ]D   bought a set so they can get
OL,14, ]D   both ORACLE and Ceefax.
OL,15, ]D
OL,16, ]DADMellor says that in 1993 you'll
OL,17, ]D   still have Ceefax and you don't
OL,18, ]D   need any other service.
OL,19, ]                                    R
OL,20,D]G    WRITE TO YOUR OWN MP AT THE
OL,21,D]G HOUSE OF COMMONS, LONDON SW1 - OR
OL,22,D]GDAVID MELLOR, BROADCASTING MINISTER
OL,23,D]G   HOUSE OF COMMONS, LONDON SW1
